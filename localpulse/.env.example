# ---------------------------------------------------------------------------
# LocalPulse — mock environment. `npm run setup` copies this to .env and fills
# in the generated secrets. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public base URL of this API (Twilio + Google must be able to reach it; use
# an ngrok / cloudflared tunnel in development).
PUBLIC_API_URL=http://localhost:3000
# Front-end URL the OAuth callback redirects back to.
APP_BASE_URL=http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
# Owner connection: used ONLY by migrations and seeding.
MIGRATION_DATABASE_URL=postgres://localpulse:localpulse_dev@localhost:5432/localpulse
# Runtime connection as the RLS-restricted role created by migration 001.
DATABASE_URL=postgres://app_user:app_user_dev_pw@localhost:5432/localpulse
APP_DB_PASSWORD=app_user_dev_pw
# Supabase: use the pooler URL (transaction mode is fine) and a dedicated
# app_user role — not the `service_role` key, which bypasses RLS.

# --- App auth (bring your own IdP) -----------------------------------------
# HS256 secret for the dev token issuer. In production swap to AUTH_JWKS_URL
# (Supabase: https://<project>.supabase.co/auth/v1/.well-known/jwks.json).
AUTH_JWT_SECRET=replace-me-with-32+-random-bytes
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=localpulse-dev
AUTH_JWT_AUDIENCE=localpulse-api

# --- Secrets for app-layer crypto ------------------------------------------
# 32 random bytes, base64. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# HMAC key for signing the OAuth `state` parameter.
STATE_SIGNING_SECRET=replace-me-with-32+-random-bytes

# --- Google Business Profile (OAuth 2.0 web client) -------------------------
# Google Cloud Console -> APIs & Services -> Credentials. Enable:
#   My Business Account Management API, My Business Business Information API,
#   Google My Business API (v4, media). GBP API access must be approved.
GOOGLE_CLIENT_ID=1234567890-mock.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-mock-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/google/oauth/callback

# --- Claude (caption generation) --------------------------------------------
ANTHROPIC_API_KEY=sk-ant-mock-key
CLAUDE_MODEL=claude-opus-5-5

# --- Twilio (A2P 10DLC) -----------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=mock-auth-token
# Messaging Service attached to your registered 10DLC campaign. Per-tenant
# services in sms_settings.messaging_service_sid override this.
TWILIO_DEFAULT_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Keep true outside local testing; validates X-Twilio-Signature.
TWILIO_VALIDATE_WEBHOOKS=true
# Log messages instead of calling Twilio (dev without credentials).
SMS_DRY_RUN=true

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=5
