{
  "name": "localpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Micro-SaaS: AI-captioned Google Business Profile photo posting + automated review-request SMS",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "tsx src/workers/review-dispatcher.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "dev:token": "tsx scripts/dev-token.ts",
    "test": "vitest run",
    "setup": "bash scripts/setup.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
